# ==========================================
# CollabSpace Server Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# PostgreSQL Connection String (Prisma)
# Example Local: postgresql://postgres:postgres@localhost:5432/collabspace?schema=public
# Example Render / Neon: postgresql://username:password@ep-xyz.region.aws.neon.tech/collabspace?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collabspace?schema=public"

# Redis Connection URL (Optional - Fallback to in-memory)
# Example Local: redis://localhost:6379
# Example Upstash: rediss://default:password@xyz.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secret
JWT_SECRET="collabspace_super_secret_jwt_key_2026_change_me_in_production"

# Allowed Client Origin (e.g. your Vercel frontend URL)
CLIENT_URL="http://localhost:5173"
